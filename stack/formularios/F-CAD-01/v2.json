              {
                "label": "Casado",
                "value": "casado"
              },
              {
                "label": "Divorciado",
                "value": "divorciado"
              },
              {
                "label": "Viúvo",
                "value": "viuvo"
              },
              {
                "label": "União estável",
                "value": "uniao_estavel"
